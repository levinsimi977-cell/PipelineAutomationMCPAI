# Saved run selections contain resolved per-run credentials (app_id/dev_key,
# base64-obfuscated but not encrypted -- see infra/user_interface_use_case/utils/secrets.py).
# They must never be committed.
data/runs/

# Compiled Python bytecode caches -- always regenerated automatically, never
# meant to be kept or committed.
__pycache__/
*.pyc

# Local secrets -- see SETUP.md for what each of these needs to contain and
# how to create them. Never committed, on purpose.
infra/agents/answerAgent/config.py

# Sandbox app replicas created at runtime during pipeline execution.
sandboxes/
