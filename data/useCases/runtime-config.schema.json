{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "UseCase Runtime Config",
    "type": "object",
    "required": [
      "selected_use_case_ids",
      "selected_rule_profiles_by_use_case",
      "disabled_rule_ids",
      "runtime_overrides"
    ],
    "properties": {
      "selected_use_case_ids": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "selected_rule_profiles_by_use_case": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "disabled_rule_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "runtime_overrides": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "use_cuid": { "type": "boolean" },
            "cuid_value": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      }
    }
  }